{
  "expo": {
    "name": "Cozy Backpack",
    "slug": "cozy-backpack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "cozybackpack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icons/icon.png",
        "dark": "./assets/icons/icon-dark.png",
        "tinted": "./assets/icons/icon-tinted.png"
      },
      "bundleIdentifier": "com.emreozgoz.cozybackpack",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": [
          "tr",
          "en"
        ],
        "CFBundleAllowMixedLocalizations": true
      },
      "requireFullScreen": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CFEAF7",
        "foregroundImage": "./assets/icons/android-foreground.png",
        "monochromeImage": "./assets/icons/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.emreozgoz.cozybackpack"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6EC",
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#241E2B"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ],
          "userTrackingUsageDescription": "This lets us show you more relevant ads. The whole game plays exactly the same if you say no."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets us show you more relevant ads. The whole game plays exactly the same if you say no."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    }
  }
}
